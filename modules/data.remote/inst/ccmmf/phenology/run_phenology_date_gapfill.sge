#!/bin/bash -l
#
# Fit LM / crop-mean phenology date models, then apply overlays for 2016–2023.
# Does not overwrite canonical assigned_year=Y.parquet.
#
#   qsub /projectnb/dietzelab/ccmmf/management/scripts/phenology/run_phenology_date_gapfill.sge
#

#$ -P dietzelab
#$ -l buyin
#$ -l h_rt=8:00:00
#$ -pe omp 4 -l mem_per_core=8G
#$ -m ea
#$ -N phen_date_gapfill
#$ -j y
#$ -o /projectnb/dietzelab/ccmmf/management/phenology/matched_landiq_mslsp_v4.1.2/sge_logs/$JOB_NAME.$JOB_ID.out

set -euo pipefail

SGE_LOG_DIR=/projectnb/dietzelab/ccmmf/management/phenology/matched_landiq_mslsp_v4.1.2/sge_logs
mkdir -p "$SGE_LOG_DIR"

unset LD_PRELOAD LD_LIBRARY_PATH
module purge
module load R/4.4.3
export R_LIBS_USER=/dev/null

export CCMMF_MANAGEMENT=/projectnb/dietzelab/ccmmf/management
export CCMMF_MATCHED_DIR=$CCMMF_MANAGEMENT/phenology/matched_landiq_mslsp_v4.1.2
export GAPFILL_MODEL_DIR=$CCMMF_MANAGEMENT/phenology/gapfill_models
mkdir -p "$GAPFILL_MODEL_DIR" "$CCMMF_MATCHED_DIR/gapfill_dates"

echo "=== phenology date gapfill $(date) ==="
Rscript "$CCMMF_MANAGEMENT/scripts/phenology/fit_phenology_gapfill_models.R"
Rscript "$CCMMF_MANAGEMENT/scripts/phenology/apply_phenology_gapfill.R" \
  2016 2017 2018 2019 2020 2021 2022 2023
echo "=== phenology date gapfill done $(date) ==="
