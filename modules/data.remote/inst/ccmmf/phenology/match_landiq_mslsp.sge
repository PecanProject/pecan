#!/bin/bash -l
#
# SGE job: match LandIQ seasons to MSLSP cycles for one year.
# YEAR is passed via qsub -v YEAR=YYYY. No hardcoded year list.
#
# Submit one year:
#   qsub -v YEAR=2016 /projectnb/dietzelab/ccmmf/management/scripts/phenology/match_landiq_mslsp.sge
#
# Submit multiple years (loop):
#   for y in 2016 2018 2019 2020 2021 2022 2023; do qsub -v YEAR=$y .../match_landiq_mslsp.sge; done
#
# Before qsub from Cursor or a conda-injected shell:
#   unset LD_PRELOAD LD_LIBRARY_PATH && module purge
#
# Test locally:
#   YEAR=2016 bash .../match_landiq_mslsp.sge
#

if [ -z "$YEAR" ]; then
  echo "Error: YEAR must be set (e.g. qsub -v YEAR=2016 $0)" >&2
  exit 1
fi

#$ -P dietzelab
#$ -l buyin
#$ -l h_rt=24:00:00
#$ -pe omp 4 -l mem_per_core=8G
#$ -m ea
#$ -N match_landiq_mslsp
#$ -o /projectnb/dietzelab/ccmmf/management/phenology/matched_landiq_mslsp_v4.1.2/sge_logs/$JOB_NAME.$JOB_ID.out
#$ -e /projectnb/dietzelab/ccmmf/management/phenology/matched_landiq_mslsp_v4.1.2/sge_logs/$JOB_NAME.$JOB_ID.err

SGE_LOG_DIR=/projectnb/dietzelab/ccmmf/management/phenology/matched_landiq_mslsp_v4.1.2/sge_logs
mkdir -p "$SGE_LOG_DIR"

SCRIPT_PATH=/projectnb/dietzelab/ccmmf/management/scripts/phenology/match_landiq_mslsp.R

unset LD_PRELOAD LD_LIBRARY_PATH
module purge
module load R/4.4.3
export R_LIBS_USER=/dev/null

echo "=== MATCH year=${YEAR}  $(date) ==="
Rscript -e "YEAR <- ${YEAR}; source('${SCRIPT_PATH}')"
echo "=== MATCH year=${YEAR}  exit $?  $(date) ==="

