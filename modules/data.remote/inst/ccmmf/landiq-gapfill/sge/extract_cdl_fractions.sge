#!/bin/bash -l
#
# SGE job: extract CDL fractions by parcel (avoids login-node timeout).
#
# Submit:
#   qsub -v "YEAR=2017" /projectnb/dietzelab/ccmmf/management/landiq-gapfill/sge/extract_cdl_fractions.sge
#

#$ -P dietzelab
#$ -l buyin
#$ -l h_rt=6:00:00
#$ -l mem_per_core=8G
#$ -m ea
#$ -N cdl_extract
#$ -o /projectnb/dietzelab/ccmmf/management/landiq-gapfill/sge_logs/cdl_extract.$JOB_ID.out
#$ -e /projectnb/dietzelab/ccmmf/management/landiq-gapfill/sge_logs/cdl_extract.$JOB_ID.err

PKG_ROOT=/projectnb/dietzelab/ccmmf/management/landiq-gapfill
SCRIPT_DIR="$PKG_ROOT/scripts/cdl"
YEAR=${YEAR:-2017}

export LANDIQ_GAPFILL_ROOT="$PKG_ROOT"
export CDL_OUT_DIR="$PKG_ROOT/cdl"

echo "=== CDL extract $(date) YEAR=$YEAR ==="
module load R/4.4.3
Rscript "$SCRIPT_DIR/extract_cdl_fractions_by_parcel.R" "$YEAR"
echo "=== CDL extract exit $? $(date) ==="
